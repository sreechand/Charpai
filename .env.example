OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_UPI_ID=
NEXT_PUBLIC_UPI_NAME=

# Set these in Convex with `npx convex env set`, not in this file:
# SITE_URL=http://localhost:3000
# JWT_PRIVATE_KEY=
# JWKS=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Keep false until launch. Set true to restore signup, login and /app access.
CHARPAI_LAUNCHED=false

# Email settings belong in Convex (not NEXT_PUBLIC variables).
# RESEND_API_KEY=
# RESEND_WEBHOOK_SECRET=
# EMAIL_FROM=Charpai <notifications@your-verified-domain>
# EMAIL_OWNER_TO=
# EMAIL_ENABLED=false
# EMAIL_USER_EVENTS_TO=user  # user, owner, or both
